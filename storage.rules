rules_version = '2';

// Regras do Firebase Storage — Estudos Odonto
//
//  * Cada PDF fica em users/{uid}/materials/{materialId}/original.pdf.
//  * Só o dono pode ler. Não há URLs públicas: o app baixa o arquivo pelo backend autenticado.
//  * Upload permitido apenas:
//      - para o próprio uid;
//      - no nome fixo original.pdf;
//      - com contentType application/pdf e tamanho dentro do limite gravado no slot;
//      - se o backend tiver reservado o material (status "awaiting_upload") — isso impõe
//        o limite de quantidade de materiais e impede gravações arbitrárias;
//      - sem sobrescrever (somente criação).
//  * Exclusão apenas pelo backend.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function materialSlot(uid, materialId) {
      return firestore.get(/databases/(default)/documents/users/$(uid)/materials/$(materialId)).data;
    }

    match /users/{uid}/materials/{materialId}/original.pdf {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && firestore.exists(/databases/(default)/documents/users/$(uid)/materials/$(materialId))
        && materialSlot(uid, materialId).status == 'awaiting_upload'
        && request.resource.size <= materialSlot(uid, materialId).maxBytes;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
