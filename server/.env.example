# ============================================================
# Backend — Estudos Odonto. Copie para server/.env (não versionado).
# Em produção (Vercel), cadastre estas variáveis em
# Project → Settings → Environment Variables. Nunca faça commit de chaves.
# ============================================================
NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=demo-estudos-odonto
# Produção (Vercel): JSON da conta de serviço do Firebase (Configurações do projeto → Contas de serviço
# → Gerar nova chave privada). Cole o JSON inteiro ou em base64. SEGREDO: só nas variáveis da Vercel.
FIREBASE_SERVICE_ACCOUNT=

# --- IA ---
# gemini = usa a Gemini API (exige GEMINI_API_KEY) | fake = respostas simuladas (só dev/testes) | none = sem IA
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2
# Tempo total de uma operação de IA, incluindo novas tentativas (a função da Vercel tem limite de 60 s)
AI_TIME_BUDGET_MS=55000

# --- Controle de consumo ---
AI_DAILY_LIMIT_PER_USER=60
AI_DAILY_LIMIT_GLOBAL=400
AI_CONTEXT_MAX_CHARS=24000
AI_RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_MINUTE=300

# --- Acesso ---
# Lista de e-mails autorizados (separados por vírgula). Vazio = qualquer conta cadastrada.
ALLOWED_EMAILS=
REQUIRE_EMAIL_VERIFIED=false
CORS_ORIGINS=

# --- Limites de materiais ---
MAX_PDF_MB=20
MAX_MATERIALS_PER_USER=60
MAX_PDF_PAGES=400
MAX_NOTES_CHARS=150000
MAX_QUESTIONS_PER_QUIZ=20
MAX_FLASHCARDS_PER_REQUEST=20
MAX_MATERIALS_PER_REQUEST=5

# --- Emuladores locais (apenas desenvolvimento; remova em produção) ---
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
