# Configuração PÚBLICA do app Firebase (Console do Firebase → Configurações do projeto → Seus apps → Web).
# Esses valores identificam o projeto e não são segredos; a segurança vem das regras e do backend.
# NUNCA coloque aqui a chave da Gemini API nem credenciais de conta de serviço.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=

# Desenvolvimento local com os emuladores (npm run dev:emulators):
# VITE_USE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=demo-estudos-odonto
# VITE_FIREBASE_API_KEY=demo-key
